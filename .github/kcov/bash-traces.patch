 		// Line markers always start with kcov@
+		size_t kcovStr = cur.find("kcov@");
+
+		// A line that starts with a marker, its k repeated once per level of subshell, is a trace
+		// of its own, whatever quote the lines before it seem to leave open: bash 4.4 and later
+		// write a newline in a traced word as $'\n', and a quote of that kind, or one between
+		// double quotes, misleads getInputType (agent-squad #454).
+		if (kcovStr != std::string::npos && cur.find_first_not_of('k') == kcovStr + 1)
+			m_inputType = INPUT_NORMAL;
 
 		if (m_inputType == INPUT_SINGLE_QUOTE) {
 			m_inputType = getInputType(cur);
+			reportUncounted(cur, 0);
 			return true;
 		}
 
-		size_t kcovStr = cur.find("kcov@");
