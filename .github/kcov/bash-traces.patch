+		// A process that writes a long trace in pieces can have another's trace land in the
+		// middle of it, on the same line: only the first marker counts.
+		reportUncounted(cur, kcovStr + 1);
 
 		std::vector<std::string> parts = split_string(cur.substr(kcovStr), "@");
 
@@ -534,6 +545,19 @@
