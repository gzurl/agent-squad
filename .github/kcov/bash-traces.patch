+	// Say on stderr which traces of a line, from <from> on, are not counted, so that whoever
+	// reads the coverage knows those lines ran (agent-squad #454).
+	void reportUncounted(const std::string &str, size_t from)
+	{
+		for (size_t at = str.find("kcov@", from); at != std::string::npos; at = str.find("kcov@", at + 1)) {
+			std::vector<std::string> parts = split_string(str.substr(at), "@");
+
+			if (parts.size() >= 3 && string_is_integer(parts[2]))
+				fprintf(stderr, "kcov: did not count a trace of %s, line %s\n",
+						get_real_path(parts[1]).c_str(), parts[2].c_str());
+		}
+	}
