# What a tag's tarball leaves out: this repository's own conventions, CI, checks and tests, which a
# project's .agent-squad/playbook/ does not use. Patterns are anchored to the root.
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/.github/workflows export-ignore
/.agent-squad-checks export-ignore
/scripts/check-*.sh export-ignore
/install.sh export-ignore
/CONTRIBUTING.md export-ignore
/.github/ISSUE_TEMPLATE/outside-report.md export-ignore
# Nothing is tracked under .claude/ today; the line guards against a settings file added later.
/.claude export-ignore
/.gitignore export-ignore
