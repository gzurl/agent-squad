#!/usr/bin/env bash
# Pre-push gate of SQUAD.md §4.2: no commit reaches the remote before the project's checks pass on
# it, and none reaches main except through a PR (§2.3) or as an exception the CEO approved on an
# issue. A ref whose commit the remote's branches or tags already contain, such as a tag of a past
# release, carries no new code and goes through without checks, and a release branch is cut with no
# exception from such a commit that a tag or a held branch holds (agent-squad #482). Run by the
# pre-push shim that squad-install.sh writes into the common git directory (hooks/pre-push);
# `--no-verify` skips it, and whoever uses it says so in the PR body. It finds squad-checks.sh
# through its own location, so the same file works at the root of a repository (.githooks/ next to
# scripts/) and inside an installed playbook.
set -u

# The runner of the checks sits in ../scripts/ from this script, as an executable file. A gate that
# cannot find it cannot run, and a gate that cannot run refuses the push instead of letting it
# through, with its own message even when a directory stands in the runner's place.
hook_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
checks="$(dirname "$hook_dir")/scripts/squad-checks.sh"
if [ ! -f "$checks" ] || [ ! -x "$checks" ]; then
  echo "pre-push: $checks is missing or not executable; the gate cannot run, so the push is refused" >&2
  exit 1
fi

head="$(git rev-parse HEAD)" || exit 1
zero=0000000000000000000000000000000000000000

# The branches that only a PR changes: the remote's default one, as git records it for this remote,
# or main when git does not know it, and the release branches the project declares in
# .agent-squad-release-branches, one pattern per line, such as release/*, in the form of
# .agent-squad-checks: blank lines and comments, indented ones included, count for nothing, and the
# spaces around a pattern, a carriage return among them, are dropped (agent-squad #446). The
# declaration is read from the default branch's tip as last fetched, so that a push cannot lift it
# with its own commit; when the tip holds none, from the working tree.
# A push by URL names no remote, and git gives the URL as both arguments: the remote whose URL, or
# push URL, it is stands for it, so that its default branch and its declaration hold as for a push
# by its name (agent-squad #450). A URL that no remote has is taken as it is.
remote="${1:-}"
if ! git remote | grep -qxF -- "$remote"; then
  urls="$(git config --get-regexp '^remote\..*\.(url|pushurl)$' 2>/dev/null)"
  while read -r key value; do
    [ "$value" = "${2:-}" ] || continue
    key="${key#remote.}"
    remote="${key%.*}"
    break
  done <<<"$urls"
fi
protected="$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null)"
protected="${protected#"$remote"/}"
[ -n "$protected" ] || protected=main
declared="$(git show "refs/remotes/$remote/$protected:.agent-squad-release-branches" 2>/dev/null)" \
  || declared="$(cat "$(git rev-parse --show-toplevel)/.agent-squad-release-branches" 2>/dev/null)"
# `held <branch>` passes when only a PR changes the branch.
held() {
  local pattern
  [ "$1" = "$protected" ] && return 0
  while IFS= read -r pattern || [ -n "$pattern" ]; do
    pattern="${pattern#"${pattern%%[![:space:]]*}"}"
    pattern="${pattern%"${pattern##*[![:space:]]}"}"
    case "$pattern" in ''|'#'*) continue ;; esac
    # shellcheck disable=SC2053 # the pattern is a glob on purpose
    [[ "$1" == $pattern ]] && return 0
  done <<<"$declared"
  return 1
}

# The remote's branches and tags, as the remote lists them now, each a line "<object> <ref>", asked
# for once: an annotated tag comes twice, as its tag object and as the commit it names (its ^{} line,
# here under the tag's own name), and only commits count (`contained`). Local remote-tracking refs
# are not trusted: one can outlive the branch it names. The list goes through squad-timeout.sh,
# beside squad-checks.sh, which stops it after SQUAD_GH_TIMEOUT seconds of wall-clock time (120
# when unset, or not a whole number above 0), and the gate says so (agent-squad #435); a remote
# that cannot be listed lists nothing, so the gate can only refuse more.
remote_tips=""
remote_listed=0
list_seconds="${SQUAD_GH_TIMEOUT:-120}"
[[ "$list_seconds" =~ ^[1-9][0-9]*$ ]] || list_seconds=120
list_remote() {
  local listing
  [ "$remote_listed" -eq 0 ] || return 0
  listing="$("$(dirname "$checks")/squad-timeout.sh" "$list_seconds" git ls-remote --heads --tags "$remote" 2>/dev/null)"
  [ $? -ne 124 ] || echo "pre-push: $remote did not list its branches and tags within $list_seconds s, so every ref pushed counts as new code" >&2
  remote_tips="$(awk -F '\t' '{ sub(/\^\{\}$/, "", $2); print $1, $2 }' <<<"$listing")"
  remote_listed=1
}

# `contained <commit> <tip>...` passes when one of the tips that this repository has contains the
# commit: one rev-list for them all, which lists nothing then (QA's finding on PR #484). A tip that
# is no commit here counts for nothing.
contained() {
  local commit="$1" known found
  shift
  known="$(printf '%s\n' "$@" | git cat-file --batch-check='%(objectname) %(objecttype)' 2>/dev/null | awk '$2 == "commit" { print $1 }')"
  [ -n "$known" ] || return 1
  # shellcheck disable=SC2086 # the tips are split on purpose, one argument each
  found="$(git rev-list -n 1 "$commit" --not $known 2>/dev/null)" || return 1
  [ -z "$found" ]
}

# `on_remote <commit>` passes when one of the remote's branches or tags already contains the
# commit: a ref pointing there carries no new code, such as a tag of a past release (agent-squad
# #143). `cut_from <commit>` passes when the remote's default branch, one of its held branches or a
# tag does, which reviewed it: the commits a release branch may be cut from (agent-squad #482). A
# feature branch's commit, which no PR has reviewed, is none of them (QA's finding on PR #484).
on_remote() {
  list_remote
  # shellcheck disable=SC2046 # the commits are split on purpose, one argument each
  contained "$1" $(cut -d' ' -f1 <<<"$remote_tips")
}
cut_from() {
  local tip ref tips=()
  list_remote
  while read -r tip ref; do
    case "$ref" in
      refs/tags/*) tips+=("$tip") ;;
      refs/heads/*) ! held "${ref#refs/heads/}" || tips+=("$tip") ;;
    esac
  done <<<"$remote_tips"
  [ "${#tips[@]}" -gt 0 ] && contained "$1" "${tips[@]}"
}

# The checks test the working tree, so every new commit being pushed must be the one checked out.
# A ref whose commit is already on the remote, like a deletion, pushes no code. A push that creates
# a release branch, which the remote does not have yet, at a commit that the default branch, a held
# branch or a tag holds, as a release branch is cut from a tag, puts there nothing a PR has not
# reviewed, and needs no exception (agent-squad #482); the default branch, a branch that exists,
# and any other commit still do.
pushes_code=0
held_pushed=""
while read -r local_ref local_sha remote_ref remote_sha _; do
  [ "$local_sha" = "$zero" ] && continue # a deletion pushes no code
  commit="$(git rev-parse -q --verify "$local_sha^{commit}")" || continue
  case "$remote_ref" in
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      if held "$branch"; then
        [ "$remote_sha" = "$zero" ] && [ "$branch" != "$protected" ] && cut_from "$commit" && continue
        held_pushed="${held_pushed:+$held_pushed, }$branch"
      fi
      ;;
  esac
  on_remote "$commit" && continue
  if [ "$commit" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out commit; push it from a checkout of it, where the checks can run on it" >&2
    exit 1
  fi
  pushes_code=1
done

# Only a PR reviewed by QA changes a held branch. An exception is approved by the CEO on an issue
# first, and named here; --no-verify is not the way, since it would skip the checks too.
if [ -n "$held_pushed" ]; then
  if [ -z "${SQUAD_MAIN_EXCEPTION:-}" ]; then
    echo "pre-push: this push updates $held_pushed, which only a PR reviewed by QA may change (SQUAD.md §2.3), so it is refused. For an exception the CEO approved on an issue, push again with SQUAD_MAIN_EXCEPTION=#<issue>" >&2
    exit 1
  fi
  issue="${SQUAD_MAIN_EXCEPTION#\#}"
  case "$issue" in
    ''|0*|*[!0-9]*)
      echo "pre-push: SQUAD_MAIN_EXCEPTION='$SQUAD_MAIN_EXCEPTION' is not an issue number (digits, with or without a leading #), so the push to $held_pushed is refused" >&2
      exit 1
      ;;
  esac
  echo "pre-push: pushing to $held_pushed as the exception the CEO approved on #$issue; the checks still run on new code" >&2
fi
[ "$pushes_code" -eq 1 ] || exit 0 # only deletions and commits the remote has: nothing to check

# Uncommitted changes would be checked in place of what is pushed.
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: tracked files have uncommitted changes; the checks would test them, not the push. Commit or stash them first" >&2
  exit 1
fi

# Checks that run for minutes can outlast the connection that git push opened before this gate
# ran, as across a sleep, and git then dies of SIGPIPE once they pass, with nothing pushed; the
# installer keeps the connection alive with core.sshCommand where it can (agent-squad #438). After
# checks that passed and ran longer than SQUAD_LONG_CHECKS seconds (120 when unset, or not a whole
# number above 0), the gate's last line says what such a failure means, and what to do.
long="${SQUAD_LONG_CHECKS:-120}"
[[ "$long" =~ ^[1-9][0-9]*$ ]] || long=120
started=$SECONDS
"$checks"
passed=$?
took=$((SECONDS - started))
if [ "$passed" -eq 0 ] && [ "$took" -gt "$long" ]; then
  echo "pre-push: the checks passed after $took s; if git now fails with a broken pipe or exit 141, its connection to $remote closed while they ran, as across a sleep: push again" >&2
fi
exit "$passed"
