#!/usr/bin/env bash
# pre-push hook of SQUAD.md §4: no commit reaches the remote before the project's checks pass on it.
# Enabled once per clone (BOOTSTRAP.md); `--no-verify` skips it, and whoever uses it says so in the
# PR body. It finds squad-checks.sh through its own location, so the same file works at the root of
# a repository (.githooks/ next to scripts/) and inside an installed playbook.
set -u

# The runner of the checks sits in ../scripts/ from this hook. A gate that cannot find it cannot
# run, and a gate that cannot run refuses the push instead of letting it through.
hook_dir="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
checks="$(dirname "$hook_dir")/scripts/squad-checks.sh"
if [ ! -x "$checks" ]; then
  echo "pre-push: $checks is missing or not executable; the gate cannot run, so the push is refused" >&2
  exit 1
fi

head="$(git rev-parse HEAD)" || exit 1
zero=0000000000000000000000000000000000000000

# The checks test the working tree, so every commit being pushed must be the one checked out.
pushes_code=0
while read -r local_ref local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue # a deletion pushes no code
  commit="$(git rev-parse -q --verify "$local_sha^{commit}")" || continue
  if [ "$commit" != "$head" ]; then
    echo "pre-push: $local_ref is not the checked-out commit; push it from a checkout of it, where the checks can run on it" >&2
    exit 1
  fi
  pushes_code=1
done
[ "$pushes_code" -eq 1 ] || exit 0 # only deletions: nothing to check

# Uncommitted changes would be checked in place of what is pushed.
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: tracked files have uncommitted changes; the checks would test them, not the push. Commit or stash them first" >&2
  exit 1
fi

exec "$checks"
